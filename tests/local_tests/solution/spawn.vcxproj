<?xml version="1.0" encoding="utf-8"?>
<!-- Payload driver project: the peor "spawn" test driver (kernelsrc/spawn.c),
     the mandatory create-a-real-user-process test. The MSBuild post-build
     step feeds the built .sys to the peor CLI, which emits the peor kernel
     chain shellcode next to it; the loader executes that file from
     C:\shellcode on the VM. -->
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{7C08A6E9-0E2A-4A70-9D9C-9A6D06E27A44}</ProjectGuid>
    <WindowsTargetPlatformVersion>10.0.28000.0</WindowsTargetPlatformVersion>
    <WDKBuildFolder>10.0.28000.0</WDKBuildFolder>
    <ProjectName>spawn</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <DriverType>WDM</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(MSBuildThisFileDirectory)win32_kernel.props" />
  <PropertyGroup>
    <TargetName>peor_$(ProjectName)</TargetName>
    <OutDir>$(SolutionDir)out\$(Configuration)\$(PlatformName)\</OutDir>
    <IntDir>$(SolutionDir)out\$(Configuration)\$(PlatformName)\obj\$(ProjectName)\</IntDir>
    <AdditionalIncludeDirectories>$(ProjectDir)..\kernelsrc;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    <Inf2Cat>false</Inf2Cat>
    <SignMode>Off</SignMode>
  </PropertyGroup>
  <ItemGroup>
    <ClCompile Include="..\kernelsrc\spawn.c" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="PeorKernelChain" AfterTargets="Build">
    <Exec Condition="'$(Platform)'=='x64'"
          Command="python -m peor -i &quot;$(TargetPath)&quot; --platform kernel64 -o &quot;$(OutDir)$(TargetName)_chain_x64.bin&quot;"
          WorkingDirectory="$(SolutionDir)..\..\.." />
    <Exec Condition="'$(Platform)'=='Win32'"
          Command="python -m peor -i &quot;$(TargetPath)&quot; --platform kernel32 -o &quot;$(OutDir)$(TargetName)_chain_Win32.bin&quot;"
          WorkingDirectory="$(SolutionDir)..\..\.." />
  </Target>
</Project>

